DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password
DB_NAME=taskflow
ACCESS_TOKEN_SECRET=your_access_token_secret_at_least_32_characters
# Optional legacy fallback; prefer ACCESS_TOKEN_SECRET.
# JWT_SECRET=your_jwt_secret_at_least_32_characters

# Backend listener. Keep HOST=127.0.0.1 for local-only development.
# In production, set HOST to the interface required by your platform/proxy (for example 0.0.0.0).
HOST=127.0.0.1
PORT=3000

# Comma-separated exact browser origins; no paths or wildcard origins.
# Required in production; use HTTPS origins for deployed frontends.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Optional. Use "none" only for cross-site frontend/API deployments; production cookies are Secure.
# COOKIE_SAME_SITE=lax

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM=your_sender_email
